{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^apply_patch$|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/scripts/ux-nudge.sh\" advise codex",
            "timeout": 15,
            "statusMessage": "Checking UI against the design rules"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/scripts/stack-hook.sh\" codex",
            "timeout": 30,
            "statusMessage": "Checking PR stack fit"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/scripts/session-start.sh\" codex",
            "timeout": 10,
            "statusMessage": "Loading oss instructions"
          }
        ]
      }
    ]
  }
}
