{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Task|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/model-guard.sh\"",
            "timeout": 5,
            "statusMessage": "Checking subagent model"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/fable-delegate-guard.sh\"",
            "timeout": 5,
            "statusMessage": "Checking session model"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/tdd-hook.sh\" edit-check",
            "timeout": 15,
            "statusMessage": "TDD check"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/tdd-hook.sh\" stop-check",
            "timeout": 300,
            "statusMessage": "TDD gate: running tests"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/rebase-hook.sh\"",
            "timeout": 30,
            "statusMessage": "Checking branch sync with main"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/session-start.sh\"",
            "timeout": 10,
            "statusMessage": "Loading global instructions"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/fable-track.sh\"",
            "timeout": 5,
            "statusMessage": "Tracking session model"
          }
        ]
      }
    ],
    "PostModelSwitch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/fable-track.sh\"",
            "timeout": 5,
            "statusMessage": "Tracking session model"
          }
        ]
      }
    ]
  }
}
